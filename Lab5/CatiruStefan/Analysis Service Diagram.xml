      <bpmn:incoming>Flow_6b</bpmn:incoming>
      <bpmn:incoming>Flow_6c</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_RenderDashboard" name="Render Dashboard">
